doctype html

html

 head

  title Notificaciones

  link(
   href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
   rel="stylesheet"
  )

 body.container.mt-4

  h2.mb-4 Mis notificaciones

  if notificaciones.length===0

   .alert.alert-info

    | No tenés notificaciones

  else

   each n in notificaciones

    .card.mb-3.shadow-sm

     .card-body

      p.mb-2

       strong #{n.actor.username}

       if n.tipo==="comentario"

        |  comentó tu publicación

       if n.tipo==="follow"

        |  comenzó a seguirte

       if n.tipo==="valoracion"

        |  valoró tu imagen

       if n.tipo==="interes"

        |  está interesado en tu imagen

      if n.tipo==="bloqueo"
      
        | tu publicación fue bloqueada por acumulación de denuncias

      small.text-muted

       = new Date(n.createdAt).toLocaleString("es-AR")