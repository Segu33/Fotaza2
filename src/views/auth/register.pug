doctype html

html(lang="es")

  head

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    )

    title Registro - Fotaza 2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

    style.

      body{
        background:#f5f5f5;
      }

      .left-panel{
        background: linear-gradient(
          135deg,
          #212529,
          #343a40
        );
        color:white;
        min-height:100vh;
      }

      .logo{
        max-width:320px;
      }

      .feature{
        font-size:1.1rem;
        margin-bottom:12px;
      }

  body

    .container-fluid

      .row.min-vh-100

        // IZQUIERDA
        .col-lg-6.d-flex.flex-column.justify-content-center.align-items-center.left-panel

          img.logo.mb-4(
            src="/img/Fotaza2.png"
            alt="Fotaza 2"
          )

          h2.mb-4
            | Únete a la comunidad

          p.feature
            | 📸 Comparte tus mejores fotografías

          p.feature
            | ❤️ Interactúa con otros usuarios

          p.feature
            | ⭐ Guarda tus publicaciones favoritas

          p.feature
            | 🔔 Recibe notificaciones en tiempo real

        // DERECHA
        .col-lg-6.d-flex.align-items-center.justify-content-center.bg-light

          .card.shadow.border-0.rounded-4(
            style="width:450px;"
          )

            .card-body.p-5

              h2.text-center.mb-4
                | Crear cuenta

              if error

                .alert.alert-danger.text-center
                  = error

              form(
                action="/register"
                method="POST"
              )

                .mb-3

                  label.form-label
                    | Usuario

                  input.form-control(
                    type="text"
                    name="username"
                    placeholder="Tu nombre de usuario"
                    required
                  )

                .mb-3

                  label.form-label
                    | Correo electrónico

                  input.form-control(
                    type="email"
                    name="email"
                    placeholder="ejemplo@email.com"
                    required
                  )

                .mb-4

                  label.form-label
                    | Contraseña

                  input.form-control(
                    type="password"
                    name="password"
                    placeholder="********"
                    required
                  )

                button.btn.btn-danger.w-100(
                  type="submit"
                )
                  | Registrarme

              hr

              .text-center

                p.mb-2.text-muted
                  | ¿Ya tienes una cuenta?

                a.text-decoration-none(
                  href="/login"
                )
                  | Iniciar sesión