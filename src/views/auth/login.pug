extends ../layouts/main

block content

  .row.justify-content-center.mt-5

    .col-md-5.col-lg-4

      .card.shadow-lg.border-0.rounded-4

        .card-body.p-5

          // LOGO
          .text-center.mb-4

            img(
              src="/img/Fotaza2.png"
              alt="Fotaza 2"
              style="max-width:280px;"
            )

          p.text-center.text-muted.mb-4
            | Comparte y descubre imágenes increíbles

          if error

            .alert.alert-danger.text-center.mb-4
              = error

          form(
            method="POST"
            action="/login"
          )

            .mb-3

              label.form-label
                | Correo electrónico

              input.form-control(
                type="email"
                name="email"
                placeholder="correo@ejemplo.com"
                required
              )

            .mb-4

              label.form-label
                | Contraseña

              input.form-control(
                type="password"
                name="password"
                placeholder="********"
                required
              )

            button.btn.btn-danger.w-100(
              type="submit"
            )
              | Iniciar sesión

          hr.my-4

          p.text-center.mb-0

            | ¿No tienes cuenta?

            a.ms-2(
              href="/register"
            )
              | Registrarse