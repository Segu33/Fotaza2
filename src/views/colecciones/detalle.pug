extends ../layouts/main

block content

    .container.mt-4

        .d-flex.justify-content-between.align-items-center.mb-4

            div
                h2.mb-1 📁 #{coleccion.nombre}
                p.text-muted.mb-0
                    | #{publicaciones.length} publicación(es)

            a.btn.btn-outline-secondary(href="/colecciones")
                | ← Volver a Mis Colecciones

        if publicaciones.length === 0

            .alert.alert-info
                | Esta colección todavía no tiene publicaciones.

        else

            .row

                each publicacion in publicaciones

                    .col-md-6.col-lg-4.col-xl-3.mb-4

                        .card.shadow-sm.h-100

                            a(
                                href=`/publicaciones/${publicacion.id}`
                                style="text-decoration:none;"
                            )

                                if publicacion.imagenes && publicacion.imagenes.length > 0

                                    img.card-img-top(
                                        src=publicacion.imagenes[0].url
                                        alt=publicacion.titulo
                                        style="height:220px; object-fit:cover;"
                                    )

                                else

                                    .d-flex.justify-content-center.align-items-center.bg-light(
                                        style="height:220px;"
                                    )

                                        span.text-muted
                                            | Sin imagen

                            .card-body.d-flex.flex-column

                                h5.card-title.mb-1
                                    = publicacion.titulo

                                if publicacion.usuario

                                    p.text-muted.small.mb-3
                                        | 👤 #{publicacion.usuario.username}

                                form(
                                    action=`/colecciones/quitar`
                                    method="POST"
                                    class="mt-auto"
                                )

                                    input(
                                        type="hidden"
                                        name="coleccion_id"
                                        value=coleccion.id
                                    )

                                    input(
                                        type="hidden"
                                        name="publicacion_id"
                                        value=publicacion.id
                                    )

                                    button.btn.btn-outline-danger.w-100(type="submit")
                                        | 🗑 Quitar de la colección