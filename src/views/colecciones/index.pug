extends ../layouts/main

block content

  .container.mt-4

    .d-flex.justify-content-between.align-items-center.mb-4

      h2.mb-0 📁 Mis Colecciones

      a.btn.btn-outline-secondary(
        href=`/perfil/${session.user.id}`
      )
        | ← Volver al perfil

    .card.shadow-sm.border-0.mb-4

      .card-body

        form(
          action="/colecciones/crear"
          method="POST"
        )

          .row.g-2

            .col-md-9

              input.form-control(
                type="text"
                name="nombre"
                placeholder="Nombre de la colección"
                required
              )

            .col-md-3.d-grid

              button.btn.btn-primary(
                type="submit"
              )
                | ➕ Crear colección

    if colecciones.length === 0

      .alert.alert-info.shadow-sm

        | Todavía no creaste ninguna colección.

    else

      .row.g-3

        each coleccion in colecciones

          .col-md-6

            .card.shadow-sm.border-0

              .card-body.d-flex.justify-content-between.align-items-center

                div

                  h5.mb-1 📁 #{coleccion.nombre}

                div.d-flex.gap-2

                  a.btn.btn-outline-primary.btn-sm(
                    href=`/colecciones/${coleccion.id}`
                  )
                    | Abrir

                  form(
                    action=`/colecciones/eliminar/${coleccion.id}`
                    method="POST"
                    onsubmit="return confirm('¿Eliminar esta colección?')"
                  )

                    button.btn.btn-outline-danger.btn-sm(
                      type="submit"
                    )
                      | Eliminar