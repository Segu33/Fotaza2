extends ../layouts/main

block content

  - const img = publicacion.imagenes[0]
  - const userId = session && session.user ? session.user.id : null
  - const yaLike = img.valoraciones ? img.valoraciones.some(v => v.user_id === userId) : false
  - const yaFavorito = img.favoritos ? img.favoritos.some(f => f.user_id === userId) : false

  .container.mt-4

    .card.border-0.shadow-lg.rounded-4.overflow-hidden

      .row.g-0

        //===================================
        // IMAGEN PRINCIPAL
        //===================================

        .col-lg-5

          img.rounded-4(
            src=img.url
            style="width:100%;max-height:600px;object-fit:contain;"
          )

        //===================================
        // PANEL DERECHO
        //===================================

        .col-lg-5.p-4

          //=========================
          // AUTOR
          //=========================

          .d-flex.align-items-center.mb-4

            a(
              href=`/perfil/${publicacion.usuario.id}`
              class="text-decoration-none"
            )

              if publicacion.usuario.foto_perfil

                img.rounded-circle.shadow-sm.me-3(
                  src=publicacion.usuario.foto_perfil
                  alt=publicacion.usuario.username
                  style="width:55px;height:55px;object-fit:cover;"
                )

              else

                img.rounded-circle.shadow-sm.me-3(
                  src=`https://ui-avatars.com/api/?name=${encodeURIComponent(publicacion.usuario.username)}&background=random&size=120`
                  alt=publicacion.usuario.username
                  style="width:55px;height:55px;object-fit:cover;"
                )

            .flex-grow-1

              a.text-decoration-none.text-dark.fw-bold(
                href=`/perfil/${publicacion.usuario.id}`
              )
                = publicacion.usuario.username

              br

              small.text-muted
                | Ver perfil

          h2.mb-2= publicacion.titulo

          p.text-muted.mb-3= publicacion.descripcion

          hr

          //=========================
          // ACCIONES
          //=========================

          .d-flex.justify-content-between.align-items-center.mb-4

            form(
              action="/valoraciones/like"
              method="POST"
              class="m-0"
            )

              input(
                type="hidden"
                name="imagen_id"
                value=img.id
              )

              button.btn.btn-link.text-danger.text-decoration-none.p-0.fs-5(
                type="submit"
                title="Me gusta"
              )

                | ❤️ #{img.valoraciones ? img.valoraciones.length : 0}

            .dropdown

              button.btn.btn-light.btn-sm.rounded-circle.shadow-sm(
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              )

                | ⋮

              ul.dropdown-menu.dropdown-menu-end.shadow

                li

                  a.dropdown-item(
                    href=`/colecciones/agregar/${publicacion.id}`
                  )

                    | 📁 Guardar en colección

                li

                  form(
                    action="/favoritos/toggle"
                    method="POST"
                    class="m-0"
                  )

                    input(
                      type="hidden"
                      name="imagen_id"
                      value=img.id
                    )

                    button.dropdown-item(
                      type="submit"
                    )

                      | ⭐ #{yaFavorito ? "Quitar de favoritos" : "Agregar a favoritos"}

                li

                  a.dropdown-item.text-danger(
                    href=`/denuncias/crear/${img.id}`
                  )

                    | 🚩 Denunciar

                if session.user && session.user.id === publicacion.user_id

                  li

                    hr.dropdown-divider

                  li

                    a.dropdown-item(
                      href=`/publicaciones/editar/${publicacion.id}`
                    )

                      | ✏️ Editar publicación

                  li

                    form(
                      action=`/publicaciones/eliminar/${publicacion.id}`
                      method="POST"
                      class="m-0"
                      onsubmit="return confirm('¿Eliminar esta publicación?')"
                    )

                      button.dropdown-item.text-danger(
                        type="submit"
                      )

                        | 🗑 Eliminar publicación

          hr

          //===================================
          // COMENTARIOS
          //===================================


          .d-flex.justify-content-between.align-items-center.mb-3

            h5.mb-0
              | Comentarios

            if session.user && session.user.id === publicacion.user_id

              form(
                action=`/publicaciones/${publicacion.id}/comentarios`
                method="POST"
                class="m-0"
              )

                if publicacion.comentarios_habilitados

                  button.btn.btn-warning.btn-sm(
                    type="submit"
                  )
                    | 🔒 Cerrar comentarios

                else

                  button.btn.btn-success.btn-sm(
                    type="submit"
                  )
                    | 🔓 Abrir comentarios

          if publicacion.comentarios && publicacion.comentarios.length > 0

            .overflow-auto(
              style="max-height:320px;"
            )

              each comentario in publicacion.comentarios

                .border-bottom.py-3

                  .d-flex.justify-content-between.align-items-start

                    .d-flex

                      a(
                        href=`/perfil/${comentario.usuario.id}`
                        class="text-decoration-none"
                      )

                        if comentario.usuario.foto_perfil

                          img.rounded-circle.me-3(
                            src=comentario.usuario.foto_perfil
                            alt=comentario.usuario.username
                            style="width:42px;height:42px;object-fit:cover;"
                          )

                        else

                          img.rounded-circle.me-3(
                            src=`https://ui-avatars.com/api/?name=${encodeURIComponent(comentario.usuario.username)}&background=random&size=100`
                            alt=comentario.usuario.username
                            style="width:42px;height:42px;object-fit:cover;"
                          )

                      div

                        a.text-decoration-none.text-dark.fw-semibold.small(
                          href=`/perfil/${comentario.usuario.id}`
                        )
                          = comentario.usuario.username

                        p.small.mb-0.mt-1
                          = comentario.texto

                    if session.user && session.user.id === publicacion.user_id

                      form(
                        action=`/comentarios/eliminar/${comentario.id}`
                        method="POST"
                        class="ms-2"
                        onsubmit="return confirm('¿Eliminar este comentario?')"
                      )

                        button.btn.btn-sm.btn-outline-danger(
                          type="submit"
                          title="Eliminar comentario"
                        )
                          | 🗑

          else

            p.text-muted.small
              | Todavía no hay comentarios.

          if publicacion.comentarios_habilitados

            form(
              action="/comentarios/crear"
              method="POST"
              class="mt-3"
            )

              input(
                type="hidden"
                name="publicacion_id"
                value=publicacion.id
              )

              .input-group

                input.form-control(
                  type="text"
                  name="texto"
                  placeholder="Escribí un comentario..."
                  required
                )

                button.btn.btn-primary(
                  type="submit"
                )
                  | Enviar

          else

            .alert.alert-warning.mt-3.mb-0

              | Los comentarios están deshabilitados para esta publicación.

        //===================================
        // RELACIONADAS
        //===================================

        .col-lg-2.p-3

          h6.text-muted.mb-3
            | Relacionadas

          each rel in relacionadas.slice(0,4)

            if rel.imagenes && rel.imagenes.length > 0

              a(
                href=`/publicaciones/${rel.id}`
              )

                img.rounded-3.mb-3.shadow-sm(
                  src=rel.imagenes[0].url
                  style="width:100%;"
                )

    hr.my-5

    h2.mb-4

      | Más como esto

    .row.row-cols-2.row-cols-md-4.g-3

      each rel in relacionadas

        if rel.imagenes && rel.imagenes.length > 0

          .col

            a(
              href=`/publicaciones/${rel.id}`
            )

              img.rounded-4.shadow-sm(
                src=rel.imagenes[0].url
                style="width:100%;"
              )