h1(style="text-align:center; margin-top:20px;") Feed

each pub in publicaciones
  div(style="border:1px solid #ddd; margin:20px auto; padding:20px; border-radius:12px; width:400px; background:#fafafa; box-shadow:0 2px 8px rgba(0,0,0,0.05);")

    h2(style="margin-bottom:5px")= pub.titulo
    p(style="color:#555")= pub.descripcion

    if pub.usuario
      p(style="font-size:12px; color:#888") Publicado por: #{pub.usuario.username}

    if pub.imagenes && pub.imagenes.length > 0
      - const img = pub.imagenes[0]
      - const userId = 1
      - const yaLike = img.valoraciones ? img.valoraciones.some(v => v.user_id === userId) : false

      img(src=img.url, width="100%", style="border-radius:10px; margin-top:10px;")

      // ❤️ CONTADOR
      p(style="font-weight:bold; color:#ff4d6d; margin-top:10px;")
        | ❤️ #{img.valoraciones ? img.valoraciones.length : 0} likes

      // ❤️ BOTÓN
      form(action="/valoraciones/like" method="POST" style="margin-bottom:10px;")
        input(type="hidden" name="imagen_id" value=img.id)

        if yaLike
          button(
            type="submit"
            style="background:#aaa; color:white; border:none; padding:6px 12px; border-radius:20px; cursor:pointer;"
          ) 💔 Unlike
        else
          button(
            type="submit"
            style="background:#ff4d6d; color:white; border:none; padding:6px 12px; border-radius:20px; cursor:pointer;"
          ) ❤️ Like

    // 💬 COMENTARIOS
    h4(style="margin-top:15px") Comentarios:

    if pub.comentarios && pub.comentarios.length > 0
      each com in pub.comentarios
        p(style="background:#eee; padding:6px 10px; border-radius:8px; margin-bottom:5px;")
          b #{com.usuario.username}:
          |  #{com.texto}
    else
      p(style="color:#888") No hay comentarios

    // ✍️ FORMULARIO
    form(action="/comentarios/crear" method="POST" style="margin-top:10px;")
      input(type="hidden" name="publicacion_id" value=pub.id)
      input(
        type="text"
        name="texto"
        placeholder="Escribí un comentario..."
        required
        style="padding:6px; width:70%; border-radius:6px; border:1px solid #ccc;"
      )
      button(
        type="submit"
        style="padding:6px 12px; margin-left:5px; border:none; background:#007bff; color:white; border-radius:6px; cursor:pointer;"
      ) Comentar

    hr