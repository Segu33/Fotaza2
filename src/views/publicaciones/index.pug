extends ../layouts/main

block content

  .row#galleria(
    data-masonry='{"percentPosition": true }'
  )

    each pub in publicaciones

      - const img = pub.imagenes && pub.imagenes.length > 0 ? pub.imagenes[0] : null

      if img

        .col-12.col-sm-6.col-md-4.col-lg-3.mb-4.grid-item

          a(
            href=`/publicaciones/${pub.id}`
            style="text-decoration:none;"
          )

            .card.border-0.rounded-4.shadow-sm.overflow-hidden

              img.card-img-top(
                src=img.url
                alt=pub.titulo
                style="width:100%;height:auto;display:block;"
              )

              .card-body

                h6.card-title.text-dark.mb-2.text-truncate
                  = pub.titulo

                if pub.etiquetas && pub.etiquetas.length

                  .d-flex.flex-wrap.gap-1.mb-2

                    each etiqueta in pub.etiquetas

                      span.badge.bg-secondary
                        | ##{etiqueta.nombre}

                if pub.usuario

                  small.text-muted
                    | por #{pub.usuario.username}

block scripts

  script.

    document.addEventListener("DOMContentLoaded", function () {

      const grid = document.querySelector("#galleria");

      if (!grid) return;

      imagesLoaded(grid, function () {

        new Masonry(grid, {
          itemSelector: ".grid-item",
          percentPosition: true
        });

      });

    });