extends ../layouts/main

block content

  .row.justify-content-center.mt-5

    .col-md-8.col-lg-6

      .card.shadow-lg.border-0.rounded-4

        .card-body.p-5

          h2.text-center.mb-4
            | 📸 Crear publicación

          p.text-center.text-muted.mb-4
            | Comparte una nueva imagen con la comunidad

          form(
            action="/publicaciones/crear"
            method="POST"
            enctype="multipart/form-data"
          )

            .mb-3

              label.form-label
                | Título

              input.form-control(
                type="text"
                name="titulo"
                placeholder="Ej: Mi nueva PC Gamer"
                required
              )

            .mb-3

              label.form-label
                | Descripción

              textarea.form-control(
                name="descripcion"
                rows="4"
                placeholder="Describe tu publicación..."
              )

            .mb-4

              label.form-label
                | Imagen

              input.form-control(
                type="file"
                name="imagen"
                accept="image/*"
                required
              )

            button.btn.btn-primary.w-100(
              type="submit"
            )
              | 🚀 Publicar