nav.navbar.navbar-expand-lg.bg-white.border-bottom.shadow-sm.sticky-top

  .container-fluid

    // ==========================
    // LOGO
    // ==========================

    a.navbar-brand(
      href="/publicaciones"
    )

      img(
        src="/img/Fotaza2.png"
        alt="Fotaza 2"
        style="height:50px;"
      )

    // ==========================
    // BUSCADOR
    // ==========================

    form.d-flex.mx-auto(
      action="/publicaciones"
      method="GET"
      style="width:50%;"
    )

      input.form-control.rounded-pill(
        type="text"
        name="q"
        placeholder="Buscar publicaciones..."
      )

    // ==========================
    // MENÚ
    // ==========================

    .d-flex.align-items-center.gap-2

      // Inicio

      a.btn.btn-light.rounded-pill(
        href="/publicaciones"
      )
        | 🏠 Inicio

      if session && session.user

        // ==========================
        // NOTIFICACIONES
        // ==========================

        .dropdown

          button.btn.btn-light.rounded-pill.position-relative(
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          )

            | 🔔

            if notificaciones && notificaciones.length > 0

              span.position-absolute.top-0.start-100.translate-middle.badge.rounded-pill.bg-danger

                = notificaciones.length

          ul.dropdown-menu.dropdown-menu-end.shadow(
            style="width:320px;"
          )

            if notificaciones && notificaciones.length > 0

              each n in notificaciones

                li

                  a.dropdown-item.small(
                    href=`/notificaciones/abrir/${n.id}`
                  )

                    if n.tipo === "comentario"

                      | 💬 #{n.actor.username} comentó tu publicación

                    else if n.tipo === "valoracion"

                      | ❤️ #{n.actor.username} dio like a tu publicación

                    else if n.tipo === "follow"

                      | 👤 #{n.actor.username} comenzó a seguirte

                    else if n.tipo === "interes"

                      | ⭐ #{n.actor.username} guardó tu publicación

                    else if n.tipo === "bloqueo"

                      | 🚫 Tu publicación fue eliminada por infringir las normas de la comunidad
                      
                    else if n.tipo === "mensaje"

                      | 💬 #{n.actor.username} te envió un mensaje

            else

              li

                span.dropdown-item-text.text-muted

                  | No tienes notificaciones

            li

              hr.dropdown-divider

            li

              a.dropdown-item.text-center(
                href="/notificaciones"
              )

                | Ver todas

        // ==========================
        // CREAR PUBLICACIÓN
        // ==========================

        a.btn.btn-primary.rounded-pill(
          href="/publicaciones/crear"
        )

          | ➕

        // ==========================
        // PERFIL
        // ==========================

        a.btn.btn-outline-dark.rounded-pill(
          href=`/perfil/${session.user.id}`
        )

          | 👤 Perfil

        // ==========================
        // PANEL ADMINISTRADOR
        // ==========================

        if session.user.rol === "administrador"

          a.btn.btn-dark.rounded-pill.border.border-warning.border-2(
            href="/administrador"
            title="Centro de Administración"
          )

            | 🛡 Administración

        // ==========================
        // MENSAJES
        // ==========================

        a.btn.btn-outline-primary.rounded-pill(
          href="/mensajes"
        )

          | 💬 Mensajes

          