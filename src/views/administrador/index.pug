doctype html

html

  head

    title Centro de Administración | Fotaza2

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    )

  body.bg-light

    .container.py-5

      // ================= HEADER =================

      .text-center.mb-5

        h1.fw-bold.text-dark
          | 📷 Fotaza2

        h3.text-secondary
          | Centro de Administración

        if session && session.user

          p.text-muted.mt-3

            | Bienvenido,

            strong #{session.user.username}

      // ================= OPCIONES =================

      .row.justify-content-center.g-4.mb-5

        // Casos pendientes

        .col-md-5.col-lg-4

          .card.border-danger.shadow.h-100

            .card-body.text-center.py-4

              h1.display-4.text-danger

                = publicacionesPendientes

              h5.mt-3

                

              p.text-muted

                | Publicaciones esperando revisión.

              a.btn.btn-danger.mt-2(
                href="/administrador/publicaciones"
              )

                i.bi.bi-shield-exclamation.me-2

                | Revisar Casos

        // Usuarios

        .col-md-5.col-lg-4

          .card.border-primary.shadow.h-100

            .card-body.text-center.py-4

              h1.display-4.text-primary

                = totalUsuarios

              h5.mt-3

                

              p.text-muted

                

              a.btn.btn-outline-primary.mt-2(
                href="/administrador/usuarios"
              )

                i.bi.bi-people-fill.me-2

                | Gestionar Usuarios

        // ================= RESUMEN DEL SISTEMA =================

.card.shadow.mt-5.mb-4

  .card-header.bg-dark.text-white

    h5.mb-0

      i.bi.bi-bar-chart-fill.me-2

      | Resumen del sistema

  .card-body

    .row.text-center.g-4

      .col-md-3

        h2.text-primary.mb-1

          = totalUsuarios

        small.text-muted

          i.bi.bi-people-fill.me-1

          | Usuarios registrados

      .col-md-3

        h2.text-success.mb-1

          = totalPublicaciones

        small.text-muted

          i.bi.bi-images.me-1

          | Publicaciones activas

      .col-md-3

        h2.text-danger.mb-1

          = publicacionesPendientes

        small.text-muted

          i.bi.bi-shield-exclamation.me-1

          | Casos pendientes

      .col-md-3

        h2.text-warning.mb-1

          = usuariosSuspendidos

        small.text-muted

          i.bi.bi-person-x-fill.me-1

          | Usuarios suspendidos
      // ================= NAVEGACIÓN =================

      .d-flex.justify-content-between

        a.btn.btn-secondary(
          href="/"
        )

          i.bi.bi-arrow-left.me-2

          | Volver al inicio

        a.btn.btn-outline-danger(
          href="/logout"
        )

          i.bi.bi-box-arrow-right.me-2

          | Cerrar sesión

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")