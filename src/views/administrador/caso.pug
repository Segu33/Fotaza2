doctype html

html

  head

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    title Expediente del Caso | Fotaza2

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    )

  body.bg-light

    .container.py-5

      .d-flex.justify-content-between.align-items-center.mb-5

        div

          h1.fw-bold.mb-1

            i.bi.bi-folder2-open.text-danger.me-2

            | Expediente del Caso

          p.text-muted.mb-0

            | Revisión individual de una publicación denunciada

        a.btn.btn-outline-secondary(
          href="/administrador/publicaciones"
        )

          i.bi.bi-arrow-left.me-2

          | Volver

      .row.g-4

        //==================================================
        // PUBLICACIÓN
        //==================================================

        .col-lg-7

          .card.shadow.border-0

            if publicacion.imagenes.length

              img.card-img-top(
                src="/uploads/" + publicacion.imagenes[0].ruta
                style="max-height:550px;object-fit:cover;"
              )

            .card-body

              h3.mb-1

                = publicacion.titulo

              p.text-muted.mb-3

                strong Caso #

                | #{publicacion.id}

              hr

              p

                strong

                  i.bi.bi-person-fill.me-2

                  | Autor:

                | #{publicacion.usuario.username}

              if publicacion.createdAt

                p

                  strong

                    i.bi.bi-calendar-event.me-2

                    | Fecha:

                  | #{new Date(publicacion.createdAt).toLocaleDateString("es-AR")}

              if publicacion.descripcion

                hr

                h5

                  i.bi.bi-card-text.me-2

                  | Descripción

                p.text-muted

                  = publicacion.descripcion

        //==================================================
        // PANEL ADMINISTRADOR
        //==================================================

        .col-lg-5

          .card.shadow.border-0

            .card-header.bg-dark.text-white

              h4.mb-0

                i.bi.bi-shield-lock-fill.me-2

                | Panel del Administrador

            .card-body

              h5.mb-3

                strong Estado del caso

              span.badge.bg-warning.text-dark.fs-6 Pendiente de revisión

                

              hr

              p

                strong Denuncias recibidas

              h2.text-danger

                = totalDenuncias

              hr

              p

                strong Prioridad

              if prioridad === "Alta"

                span.badge.bg-danger.fs-6 Alta

              else if prioridad === "Media"

                span.badge.bg-warning.text-dark.fs-6 Media

              else

                span.badge.bg-secondary.fs-6 Normal

              hr

              .alert.alert-warning

                i.bi.bi-exclamation-triangle-fill.me-2

                | Revise cuidadosamente la publicación antes de tomar una decisión. Las acciones realizadas afectarán la visibilidad del contenido y el historial del usuario.

              h5

                strong Motivos de denuncia

              .alert.alert-secondary

                i.bi.bi-tools.me-2

                | Esta información estará disponible en el Sprint 2.

              form(
                action="/administrador/publicaciones/" + publicacion.id + "/aprobar"
                method="POST"
              )

                button.btn.btn-success.w-100.mb-3

                  i.bi.bi-check-circle-fill.me-2

                  | Aprobar publicación

              form(
                action="/administrador/publicaciones/" + publicacion.id + "/dar-de-baja"
                method="POST"
                onsubmit="return confirm('¿Está seguro de dar de baja esta publicación?')"
              )

                button.btn.btn-danger.w-100

                  i.bi.bi-trash3-fill.me-2

                  | Dar de baja publicación