doctype html

html

  head

    title Gestión de Usuarios | Fotaza2

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    .container.py-5

      // ================= HEADER =================

      .d-flex.justify-content-between.align-items-center.mb-4

        div

          h2.fw-bold.mb-1
            | 👥 Gestión de Usuarios

          p.text-muted.mb-0
            | Administrar usuarios registrados en Fotaza2.

        a.btn.btn-secondary(
          href="/administrador"
        )
          | ← Volver

      // ================= TABLA =================

      .card.shadow

        .card-header.bg-primary.text-white

          h5.mb-0
            | Usuarios registrados

        .card-body.p-0

          if usuarios.length

            table.table.table-hover.mb-0.align-middle

              thead.table-light

                tr

                  th.text-center Foto

                  th Usuario

                  th Email

                  th.text-center Estado

                  th.text-center Acción

              tbody

                each usuario in usuarios

                  tr

                    // ================= FOTO =================

                    td.text-center

                      if usuario.foto_perfil

                        img.rounded-circle(
                          src=usuario.foto_perfil
                          width="50"
                          height="50"
                          style="width:50px;height:50px;object-fit:cover"
                        )

                      else

                        span.text-muted
                          | Sin foto

                    // ================= USUARIO =================

                    td

                      strong= usuario.username

                    // ================= EMAIL =================

                    td

                      = usuario.email

                    // ================= ESTADO =================

                    td.text-center

                      if usuario.activo

                        span.badge.bg-success
                          | Activo

                      else

                        span.badge.bg-danger
                          | Suspendido

                    // ================= ACCIONES =================

                    td.text-center

                      if session && session.user && usuario.id === session.user.id

                        span.text-muted
                          | Tu cuenta

                      else

                        form(
                          action=`/administrador/usuarios/${usuario.id}/estado`
                          method="POST"
                        )

                          if usuario.activo

                            button.btn.btn-sm.btn-danger(
                              type="submit"
                              onclick="return confirm('¿Desea desactivar este usuario?')"
                            )
                              | Dar de baja

                          else

                            button.btn.btn-sm.btn-success(
                              type="submit"
                              onclick="return confirm('¿Desea reactivar este usuario?')"
                            )
                              | Dar de alta

          else

            .p-4.text-center.text-muted

              h5.mb-3
                | No hay usuarios registrados.