doctype html

html(lang="es")

  head

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    )

    title Fotaza

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

    link(
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    )

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    )

    style.

      body {
        background: #f5f5f5;
        font-family: 'Inter', sans-serif;
      }

      .btn-link {
        cursor: pointer;
      }

      .btn-link:hover {
        transform: scale(1.08);
        transition: .2s;
      }

      .card {
        transition: .2s ease;
      }

      .card:hover {
        transform: translateY(-2px);
      }

      .rounded-3,
      .rounded-4 {
        transition: .2s ease;
      }

      .rounded-3:hover,
      .rounded-4:hover {
        transform: scale(1.02);
      }

      .overflow-auto::-webkit-scrollbar {
        width: 6px;
      }

      .overflow-auto::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 10px;
      }

      .overflow-auto::-webkit-scrollbar-thumb:hover {
        background: #999;
      }

  body

    if session && session.user
      include ../partials/navbar

    //==========================
    // MENSAJES
    //==========================

    if session && session.mensaje

      .container.mt-3

        if session.mensaje.tipo == "success"

          .alert.alert-success.alert-dismissible.fade.show(role="alert")

            strong ✔
            |  #{session.mensaje.texto}

            button.btn-close(
              type="button"
              data-bs-dismiss="alert"
            )

        else if session.mensaje.tipo == "warning"

          .alert.alert-warning.alert-dismissible.fade.show(role="alert")

            strong ⚠
            |  #{session.mensaje.texto}

            button.btn-close(
              type="button"
              data-bs-dismiss="alert"
            )

        else if session.mensaje.tipo == "danger"

          .alert.alert-danger.alert-dismissible.fade.show(role="alert")

            strong ✖
            |  #{session.mensaje.texto}

            button.btn-close(
              type="button"
              data-bs-dismiss="alert"
            )

        - session.mensaje = null

    .container-fluid.mt-4

      block content

    include ../partials/footer

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    )
    script(
      src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js"
    )

    script(
      src="https://cdn.jsdelivr.net/npm/imagesloaded@5/imagesloaded.pkgd.min.js"
    )
    block scripts