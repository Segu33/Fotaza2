extends ../layouts/main

block content

  -
    const otroUsuario = conversacion.usuario1.id === usuarioId
      ? conversacion.usuario2
      : conversacion.usuario1

  .container.py-4

    .row.justify-content-center

      .col-lg-8

        .card.shadow.border-0.rounded-4

          //=========================
          // CABECERA
          //=========================

          .card-header.bg-white.py-3

            .d-flex.align-items-center

              if otroUsuario.foto_perfil

                img.rounded-circle.me-3(
                  src=otroUsuario.foto_perfil
                  style="width:55px;height:55px;object-fit:cover;"
                )

              else

                img.rounded-circle.me-3(
                  src=`https://ui-avatars.com/api/?name=${encodeURIComponent(otroUsuario.username)}&background=random`
                  style="width:55px;height:55px;object-fit:cover;"
                )

              div

                h5.mb-0= otroUsuario.username

                small.text-muted Conversación privada

          //=========================
          // MENSAJES
          //=========================

          .card-body#chatBody(
            style="height:420px;overflow-y:auto;background:#f8f9fa;"
          )

            if conversacion.mensajes.length === 0

              .text-center.text-muted.mt-5

                h5 Todavía no hay mensajes

                p ¡Sé el primero en escribir!

            else

              each mensaje in conversacion.mensajes

                - const hora = new Date(mensaje.createdAt).toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" })

                if mensaje.remitente_id === usuarioId

                  .d-flex.justify-content-end.mb-3

                    .bg-primary.text-white.rounded-4.px-3.py-2.shadow-sm(
                      style="max-width:70%;"
                    )

                      div= mensaje.texto

                      small.d-block.mt-1.text-end.text-white-50= hora

                else

                  .d-flex.justify-content-start.mb-3

                    .bg-white.rounded-4.px-3.py-2.shadow-sm(
                      style="max-width:70%;"
                    )

                      strong.small.d-block.mb-1= mensaje.remitente.username

                      div= mensaje.texto

                      small.d-block.mt-1.text-muted= hora

          //=========================
          // ENVIAR MENSAJE
          //=========================

          .card-footer.bg-white

            form(
              id="formMensaje"
              action=`/mensajes/${conversacion.id}`
              method="POST"
            )

              .input-group

                input.form-control(
                  id="texto"
                  type="text"
                  name="texto"
                  placeholder="Escribí un mensaje..."
                  autocomplete="off"
                  required
                )

                button.btn.btn-primary(
                  type="submit"
                )

                  i.bi.bi-send-fill.me-2

                  | Enviar

block scripts

  script.
    const chat = document.getElementById("chatBody");

    if (chat) {
      chat.scrollTop = chat.scrollHeight;
    }

    const input = document.getElementById("texto");

    if (input) {

      input.focus();

      input.addEventListener("keydown", function(e){

        if(e.key === "Enter"){

          e.preventDefault();

          document.getElementById("formMensaje").submit();

        }

      });

    }