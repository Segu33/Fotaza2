extends ../layouts/main

block content

  .container.mt-4

    .card.shadow-sm.border-0.rounded-4.p-4.mb-4

      .row.align-items-center

        .col-md-2.text-center

          img.rounded-circle.shadow(
            src="https://ui-avatars.com/api/?name=#{usuario.username}&background=random&size=200"
            style="width:120px;height:120px;object-fit:cover;"
          )

        .col-md-7

          h2.mb-2= usuario.username

          .d-flex.gap-4.mt-3

            div
              strong= publicaciones.length
              p.mb-0.text-muted Publicaciones

            div
              strong= seguidores
              p.mb-0.text-muted Seguidores

            div
              strong= seguidos
              p.mb-0.text-muted Seguidos

        .col-md-3.text-end

          if session && session.user && session.user.id !== usuario.id

            if siguiendo

              form(
                action=`/follow/dejar-seguir/${usuario.id}`
                method="POST"
              )

                button.btn.btn-danger.rounded-pill(
                  type="submit"
                )
                  | Dejar de seguir

            else

              form(
                action=`/follow/seguir/${usuario.id}`
                method="POST"
              )

                button.btn.btn-primary.rounded-pill(
                  type="submit"
                )
                  | Seguir

    h3.mb-4 Publicaciones

    if publicaciones.length === 0

      .alert.alert-light

        | Este usuario aún no tiene publicaciones.

    else

      .row.row-cols-2.row-cols-md-3.row-cols-lg-4.g-4

        each pub in publicaciones

          .col

            a.text-decoration-none(
              href=`/publicaciones/${pub.id}`
            )

              .card.border-0.shadow-sm.h-100

                if pub.imagenes && pub.imagenes.length > 0

                  img.card-img-top(
                    src=pub.imagenes[0].url
                    style="height:250px;object-fit:cover;"
                  )

                .card-body

                  h6.card-title.text-dark.mb-1
                    = pub.titulo

                  p.card-text.text-muted.small
                    = pub.descripcion