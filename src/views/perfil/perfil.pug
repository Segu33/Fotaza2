extends ../layouts/main

block content

  .container.mt-4

    if success

      .alert.alert-success.alert-dismissible.fade.show(role="alert")

        i.bi.bi-check-circle-fill.me-2

        = success

        button.btn-close(
          type="button"
          data-bs-dismiss="alert"
          aria-label="Cerrar"
        )

    .card.shadow-sm.border-0.rounded-4.p-4.mb-4

      .row.align-items-center

        //=========================
        // FOTO DE PERFIL
        //=========================

        .col-lg-2.col-md-3.text-center.mb-3.mb-md-0

          if usuario.foto_perfil

            img.rounded-circle.shadow(
              src=usuario.foto_perfil
              alt="Foto de perfil"
              style="width:150px;height:150px;object-fit:cover;"
            )

          else

            img.rounded-circle.shadow(
              src=`https://ui-avatars.com/api/?name=${encodeURIComponent(usuario.username)}&background=random&size=300`
              alt="Avatar"
              style="width:150px;height:150px;object-fit:cover;"
            )

        //=========================
        // INFORMACIÓN DEL PERFIL
        //=========================

        .col-lg-7.col-md-6

          .d-flex.justify-content-between.align-items-start

            h2.fw-bold.mb-0= usuario.username

            if session && session.user && session.user.id === usuario.id

              .dropdown

                button.btn.p-0.border-0.bg-transparent.shadow-none(
                  type="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  title="Opciones"
                )

                  span.fs-2.fw-bold ⋮

                ul.dropdown-menu.dropdown-menu-end.shadow

                  li

                    a.dropdown-item(href="/perfil/editar")

                      i.bi.bi-pencil-square.me-2

                      | Editar perfil

                  li

                    hr.dropdown-divider

                  li

                    a.dropdown-item(href="/perfil/cambiar-password")

                      i.bi.bi-key.me-2

                      | Cambiar contraseña

                  li

                    a.dropdown-item.text-danger(href="/logout")

                      i.bi.bi-box-arrow-right.me-2

                      | Cerrar sesión

          .d-flex.gap-5.mt-4

            .text-center

              h4.mb-0= publicaciones.length

              small.text-muted Publicaciones

            .text-center

              h4.mb-0= seguidores

              small.text-muted Seguidores

            .text-center

              h4.mb-0= seguidos

              small.text-muted Seguidos

          if usuario.biografia

            .mt-4

              p.text-secondary.mb-0(style="white-space:pre-line;")

                = usuario.biografia

          if session && session.user && session.user.id === usuario.id

            .mt-4.d-flex.flex-wrap.gap-2

              a.btn.btn-outline-warning(href="/favoritos")

                i.bi.bi-star-fill.me-2

                | Mis Favoritos

              a.btn.btn-outline-primary(href="/colecciones")

                i.bi.bi-folder-fill.me-2

                | Mis Colecciones

        //=========================
        // ACCIONES
        //=========================

        .col-lg-3.col-md-3.mt-4.mt-md-0

          if session && session.user && session.user.id !== usuario.id

            .d-grid.gap-2.mb-4

              if siguiendo

                form(
                  action=`/follow/dejar-seguir/${usuario.id}`
                  method="POST"
                )

                  button.btn.btn-danger.w-100.rounded-pill(type="submit")

                    i.bi.bi-check-circle.me-2

                    | Siguiendo

              else

                form(
                  action=`/follow/seguir/${usuario.id}`
                  method="POST"
                )

                  button.btn.btn-primary.w-100.rounded-pill(type="submit")

                    i.bi.bi-person-plus.me-2

                    | Seguir

              a.btn.btn-outline-dark.w-100.rounded-pill(
                href=`/mensajes/nuevo/${usuario.id}`
              )

                i.bi.bi-chat-dots-fill.me-2

                | Mensaje
    

    .row

      //=========================
      // PUBLICACIONES
      //=========================

      .col(class=(session && session.user && session.user.id === usuario.id ? "col-lg-9" : "col-lg-12"))

        h2.mb-4

          i.bi.bi-camera-fill.me-2

          | Publicaciones

        if publicaciones.length === 0

          .card.border-0.shadow-sm.rounded-4

            .card-body.py-5.text-center

              i.bi.bi-images.display-3.text-muted.mb-3

              h4.text-muted

                | Todavía no hay publicaciones

              p.text-muted.mb-0

                | Este usuario aún no compartió ninguna publicación.

        else

          .row.row-cols-2.row-cols-md-3.g-4

            each pub in publicaciones

              .col

                .card.border-0.shadow-sm.rounded-4.h-100

                  a(
                    href=`/publicaciones/${pub.id}`
                    style="text-decoration:none;"
                  )

                    if pub.imagenes && pub.imagenes.length > 0

                      img.card-img-top.rounded-top-4(
                        src=pub.imagenes[0].url
                        alt=pub.titulo
                        style="height:250px;object-fit:cover;transition:.25s;"
                        onmouseover="this.style.transform='scale(1.03)'"
                        onmouseout="this.style.transform='scale(1)'"
                      )

                    else

                      .d-flex.justify-content-center.align-items-center.bg-light.rounded-top-4(
                        style="height:250px;"
                      )

                        .text-center.text-muted

                          i.bi.bi-image.display-6.d-block.mb-2

                          | Sin imagen

                  .card-body

                    if pub.titulo

                      h6.fw-bold.mb-2.text-dark

                        = pub.titulo

                    if pub.descripcion

                      p.text-muted.small.mb-0

                        = pub.descripcion

      //=========================
      // ÚLTIMAS PUBLICACIONES DE PERSONAS QUE SIGO
      //=========================

      if session && session.user && session.user.id === usuario.id

        .col-lg-3

          if publicacionesSeguidos && publicacionesSeguidos.length

            .card.shadow-sm.border-0.rounded-4.sticky-top(style="top:90px;")

              .card-header.bg-white

                h6.fw-bold.mb-0

                  i.bi.bi-images.me-2

                  | 👥 Últimas publicaciones de personas que sigo

              .card-body

                each pub in publicacionesSeguidos

                  if pub.imagenes && pub.imagenes.length

                    a(
                      href=`/publicaciones/${pub.id}`
                      style="text-decoration:none;"
                    )

                      .d-flex.align-items-center.mb-4

                        img.rounded-3.shadow-sm(
                          src=pub.imagenes[0].url
                          style="width:100px;height:100px;object-fit:cover;"
                        )

                        .ms-3

                          h6.text-dark.mb-1.small

                            = pub.titulo

                          small.text-muted.d-block

                            = pub.usuario.username