doctype html

html

  head

    title Perfil

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.container.mt-4

    h1= usuario.username

    //- Botón seguir / dejar de seguir
    if session && session.user && session.user.id !== usuario.id

      if siguiendo

        form(
          action=`/follow/dejar-seguir/${usuario.id}`
          method="POST"
        )

          button.btn.btn-danger.mb-3(type="submit")
            Dejar de seguir

      else

        form(
          action=`/follow/seguir/${usuario.id}`
          method="POST"
        )

          button.btn.btn-primary.mb-3(type="submit")
            Seguir

    hr

    p
      strong Seguidores:
      |  #{seguidores}

    p
      strong Seguidos:
      |  #{seguidos}

    hr

    h3 Publicaciones

    if publicaciones.length === 0

      p Este usuario no tiene publicaciones

    else

      each pub in publicaciones

        .card.mb-3

          .card-body

            h5.card-title= pub.titulo

            p.card-text= pub.descripcion