doctype html

html

  head

    title Cambiar contraseña | Fotaza2

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body.bg-light

    .container.py-5

      .row.justify-content-center

        .col-md-6

          .card.shadow

            .card-header.bg-dark.text-white

              h4.mb-0
                | 🔒 Cambiar contraseña

            .card-body

              if error

                .alert.alert-danger
                  = error

              if success

                .alert.alert-success
                  = success

              form(
                action="/perfil/cambiar-password"
                method="POST"
              )

                .mb-3

                  label.form-label
                    | Contraseña actual

                  input.form-control(
                    type="password"
                    name="passwordActual"
                    required
                  )

                .mb-3

                  label.form-label
                    | Nueva contraseña

                  input.form-control(
                    type="password"
                    name="passwordNueva"
                    minlength="6"
                    required
                  )

                .mb-4

                  label.form-label
                    | Confirmar nueva contraseña

                  input.form-control(
                    type="password"
                    name="confirmarPassword"
                    minlength="6"
                    required
                  )

                .d-flex.justify-content-between

                  a.btn.btn-secondary(
                    href=`/perfil/${session.user.id}`
                  )
                    | Cancelar

                  button.btn.btn-primary(
                    type="submit"
                  )
                    | Guardar cambios